\pard\widctlpar\sa160\sl252\slmult1\ul\b Best Practices\par

\pard{\pntext\f3\'B7\tab}{\*\pn\pnlvlblt\pnf3\pnindent0{\pntxtb\'B7}}\fi-360\li720\sa160\sl252\slmult1\ulnone\b0 start with FIND - limit the potential list of files with the correct filenames; additionaly with the selection of the last modification date\ul\b\par
{\pntext\f3\'B7\tab}\ulnone\b0 try different FIND TEXT options in the \i File Preview \i0 panel until you are happy with the find result\ul\b\par
{\pntext\f3\'B7\tab}\ulnone\b0 add into Favorites when you would use this search in future\ul\b\par
{\pntext\f3\'B7\tab}\ulnone\b0 use one of the backup options\ul\b\par
{\pntext\f3\'B7\tab}\ulnone\b0 try a REPLACE (Context Menu, middle panel) with a single file. RESTORE, when you are not satisfied with the result\ul\b\par
{\pntext\f3\'B7\tab}\ulnone\b0 REPLACE (Button) finally, after you verified the list of affected files with a FIND\ul\b\par

\pard\widctlpar\li720\sa160\sl252\slmult1\ulnone\b0\par
